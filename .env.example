# ===== 部署配置 =====
# HOST 是**服务自身**的监听地址：Docker 容器内必须 0.0.0.0 才出得来端口，
# 直接 python run.py 时它决定本机哪张网卡被占用——只想本机用可改成 127.0.0.1。
HOST=0.0.0.0
PORT=8000
# BIND_ADDR 只在 docker compose 部署时生效：决定端口**发布到宿主机的哪个地址**。
# 默认 127.0.0.1（仅本机可访问）。全站免登录（CHARTER DC-10），改成 0.0.0.0
# 就等于把全部简历与面试数据开放给整个局域网——请自行用防火墙限源。
# BIND_ADDR=127.0.0.1
LOG_LEVEL=info                      # logging level: debug/info/warning/error
# LOG_FILE=data/app.log             # 日志文件路径（默认 data/app.log，5MB×3 旋转）
# LOG_MAX_BYTES=5242880             # 单文件大小上限（默认 5MB）
# LOG_BACKUP_COUNT=3                # 备份文件数（默认 3）
# 活跃会话表 TTL（秒）：创建后从未被 WebSocket 接管的会话条目（页面刷新重开、
# 放弃连接），超过该时长会在下次创建会话时被清出内存。正在进行的面试不受影响。
SESSION_TTL_SECONDS=7200

# ===== AI 后端选择 =====
# 可选: deepseek / qwen / zhipu / openai / auto
# auto = 注册表自动探测：按 AI_PROVIDERS 注册顺序取第一个配置了有效 Key 的后端
# 注意: 切换后端需要对应的 API KEY
AI_PROVIDER=deepseek

# ===== DeepSeek (默认) =====
# 注意：API Key 必须为纯 ASCII 的真实 Key（勿用中文占位符，否则请求报编码错误）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 通义千问 (可选) =====
# QWEN_API_KEY=sk-your-qwen-key-here
# QWEN_MODEL=qwen-plus

# ===== 智谱 GLM (可选) =====
# ZHIPU_API_KEY=your-zhipu-key-here
# ZHIPU_MODEL=glm-4-flash

# ===== OpenAI (可选) =====
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini

# ===== 通用覆盖 (可选) =====
# LLM_API_KEY=sk-xxx          # 覆盖各后端各自的 API KEY
# LLM_BASE_URL=https://...     # 覆盖各后端各自的 BASE_URL
# LLM_MODEL=xxx                # 覆盖各后端各自的 MODEL

# ===== 模型调用优雅降级 (fallback, 可选) =====
# 主模型调用失败(异常/限流/超时/返回不可用内容)时,按本链顺序自动切换备用模型,
# 调用方无感知。格式: "provider:model,provider:model,...",主候选(当前 AI_PROVIDER/model)始终在首位。
# 留空 = 不降级(单模型,向后兼容)。备用 provider 需各自配置对应 API KEY
# (QWEN_API_KEY 已写入系统环境变量,可直接启用)。
# 与 deepseek-chat 能力相当的通用主力千问模型为 qwen-plus(qwen 的默认模型),
# 故备用写 qwen:qwen-plus —— 主用 deepseek-chat,失败自动降级到 qwen-plus。
# LLM_FALLBACK_CHAIN=deepseek:deepseek-chat,qwen:qwen-plus
# LLM_FALLBACK_MAX_RETRIES=3   # 最大尝试候选数(默认 3,超出候选数则取候选数)

# 单次 LLM 请求超时(秒), v8.10 起对同步/异步/流式与全部 fallback 候选统一生效。
# 此前不传该参数,落到 openai SDK 默认的 600s:上游挂起会把面试主循环钉死十分钟,
# 且 SDK 只在超时/报错后才换下一个候选 —— 等于降级链一并失效。
# 报告/职业规划等慢任务如嫌 60s 短可调大;设为 0 或非法值会回落到 60。
# LLM_TIMEOUT=60

# ===== 任务级模型绑定 (可选, opt-in) =====
# 不同任务对延迟/推理深度的要求不同：出题与追问要快，报告与职业规划可以慢而深。
# 单一 LLM_MODEL 会让"想用强模型写报告"和"想用快模型上面试对话"互相妥协。
# JSON 对象，值为 "model"（用当前 AI_PROVIDER）或 "provider:model"（跨后端绑定）。
# 任务名: parse(简历解析/追问点) question(出题) interview(追问) diagnosis(诊断)
#         rewrite(回答改写) report(报告) career(职业规划) market(市场分析)
# 未配置的任务沿用 LLM_MODEL；绑定模型的 Key 无效时自动回退默认池（不构造必然失败的候选）。
# LLM_TASK_MODELS={"diagnosis":"deepseek-chat","report":"qwen:qwen-max","parse":"zhipu:glm-4-flash"}
#
# 面试永远关深度思考(默认 true)：推理类模型(deepseek-reasoner/o1/qwen3-thinking/glm-z1)
# 首 token 延迟数秒、输出冗长，放在面试对话里会明显卡顿。
# 仅对实时链路(question/interview/diagnosis/rewrite)生效；report/career/market 不受限。
# 若某实时任务只配了推理模型，则保留原候选并告警（宁可慢，也不让调用无候选可用）。
# INTERVIEW_DISABLE_REASONING=true

# ===== 市场数据导入 (可选) =====
# 从 job-crawler（自研招聘数据采集项目）导入已采集岗位到 market.db
# JOB_CRAWLER_DB_PATH=../job-crawler/data/data.db   # job-crawler 数据文件路径

# ===== 实时采集 (可选, 内嵌 job-crawler 采集器) =====
# 前置: pip install playwright playwright-stealth 后执行 playwright install chromium
# MARKET_CRAWL_TOKEN=your-crawl-token   # 采集口令(可选)，非空时前端调用 /api/market/crawl 必须携带
# MARKET_CRAWL_CITY_LIMIT=5             # 单次采集城市数上限
# MARKET_CRAWL_PAGE_LIMIT=5             # 单城市翻页上限
# MARKET_CRAWL_RATE_LIMIT=3/minute      # 采集接口限流

# ===== Web 安全配置 =====
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000   # 允许的前端来源（逗号分隔）
# MAX_UPLOAD_BYTES=10485760     # 上传文件大小上限 (10MB)
# MAX_REQUEST_BYTES=1048576     # 普通请求体大小上限 (1MB)
# RATE_LIMIT_GLOBAL=100/minute  # 全局速率限制
# RATE_LIMIT_UPLOAD=10/minute   # 文件上传速率限制
# RATE_LIMIT_GAP=20/minute      # Gap 分析速率限制
# RATE_LIMIT_SESSION=20/minute  # 会话创建速率限制
# RATE_LIMIT_CAREER=10/minute   # 职业规划速率限制

# ===== 小米 MiMo 云端语音 (可选) =====
# 不配置时，前端自动降级为浏览器原生语音（speechSynthesis / SpeechRecognition）
# MiMo API Key：前往 MiMo 开放平台申请（MiMo-V2.5-TTS 当前限时免费，ASR 0.5元/小时）
# 注意：TTS/ASR 均走 OpenAI 兼容的 {base}/chat/completions，认证头用 api-key（sk- 开头为按量付费集群）
# MIMO_API_KEY=sk-your-mimo-key-here
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1        # 按量付费端点（Token Plan 用 https://token-plan-cn.xiaomimimo.com/v1）
# MIMO_TTS_MODEL=mimo-v2.5-tts                       # 语音合成模型
# MIMO_ASR_MODEL=mimo-v2.5-asr                       # 语音识别模型
# MIMO_TTS_VOICE=冰糖                                # 预置音色（冰糖/茉莉/苏打/白桦/Mia/Chloe/Milo/Dean）
# MIMO_TTS_STYLE=自然、专业的面试官语气，语速适中，吐字清晰。  # TTS 风格提示（可空）
# MIMO_ASR_LANGUAGE=auto                             # ASR 识别语言（auto/zh/en）
# MIMO_TIMEOUT=60                                    # 语音请求超时（秒）
# RATE_LIMIT_VOICE=20/minute                         # 语音接口限流
