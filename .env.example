# ===== AI 后端选择 =====
# 可选: deepseek / qwen / zhipu / openai
# 注意: 切换后端需要对应的 API KEY
AI_PROVIDER=deepseek

# ===== DeepSeek (默认) =====
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 通义千问 (可选) =====
# QWEN_API_KEY=sk-your-qwen-key-here
# QWEN_MODEL=qwen-plus

# ===== 智谱 GLM (可选) =====
# ZHIPU_API_KEY=your-zhipu-key-here
# ZHIPU_MODEL=glm-4-flash

# ===== OpenAI (可选) =====
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini

# ===== 通用覆盖 (可选) =====
# LLM_API_KEY=sk-xxx          # 覆盖各后端各自的 API KEY
# LLM_BASE_URL=https://...     # 覆盖各后端各自的 BASE_URL
# LLM_MODEL=xxx                # 覆盖各后端各自的 MODEL
